{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonsterOrderWilds-Ascendance",
  "mainBinaryName": "MonsterOrderWilds-Ascendance",
  "version": "0.1.9",
  "identifier": "com.jonysand.danmutools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MonsterOrderWilds-Ascendance - 控制台",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "桌面点怪悬浮窗",
        "url": "index.html#/overlay",
        "width": 440,
        "height": 360,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../MonsterOrderWilds_configs/monster_list.json": "MonsterOrderWilds_configs/monster_list.json",
      "../MonsterOrderWilds_configs/credentials.dat": "MonsterOrderWilds_configs/credentials.dat",
      "../MonsterOrderWilds_configs/voices": "MonsterOrderWilds_configs/voices",
      "../MonsterOrderWilds_configs/local_voices.zip": "MonsterOrderWilds_configs/local_voices.zip",
      "../MonsterOrderWilds_configs/dict/stop_words.utf8": "MonsterOrderWilds_configs/dict/stop_words.utf8",
      "../MonsterOrderWilds_configs/dict/user.dict.utf8": "MonsterOrderWilds_configs/dict/user.dict.utf8"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
